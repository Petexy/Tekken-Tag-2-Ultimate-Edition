# The oldest glibc the launcher's release programs are for (Ubuntu 24.04's), and how they keep to it when they are
# built on a newer system.
#
# A newer glibc gives some old functions a new default version (glibc 2.43: atan2f, acosf, sqrtf, log10f... beside
# their GLIBC_2.2.5 ones; 2.42: cfsetospeed...). A program linked against it binds those calls to the new version,
# and an older glibc then refuses to start it ("version GLIBC_2.43 not found"). ttt2_glibc_floor_header writes a
# header that binds each such function to its newest version up to the floor (.symver), made from this system's own
# libc.so.6 and libm.so.6 (every function whose default version is newer than the floor and that has an older one).
# It is force-included (-include) into the launcher's code and the SDL it builds (LauncherSDL.cmake), through the
# INTERFACE target ttt2_launcher_glibc_floor; make_appimage.sh's check (launcher/appimage/release_checks.sh) proves
# the result. A function that only exists in a newer glibc cannot be bound so: that check names it.
include_guard(GLOBAL)

set(TTT2_GLIBC_FLOOR 2.39 CACHE STRING "The oldest glibc the launcher's programs must start on (Linux)")

# ttt2_glibc_floor_header(OUTPUT FLOOR): writes OUTPUT; sets TTT2_GLIBC_FLOOR_PINS (the number of functions bound) in
# the caller's scope. Fails when this system's libc.so.6 and libm.so.6 cannot be read.
function(ttt2_glibc_floor_header output floor)
    set(libraries)
    foreach(library libc.so.6 libm.so.6)
        execute_process(COMMAND ${CMAKE_C_COMPILER} ${CMAKE_C_COMPILER_ARG1} -print-file-name=${library}
            OUTPUT_VARIABLE path OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE failed ERROR_QUIET)
        if(failed OR NOT IS_ABSOLUTE "${path}" OR NOT EXISTS "${path}")
            message(FATAL_ERROR "glibc floor: ${CMAKE_C_COMPILER} does not find ${library} (not a glibc system?)")
        endif()
        get_filename_component(path "${path}" REALPATH)
        list(APPEND libraries "${path}")
    endforeach()
    set(objdump "${CMAKE_OBJDUMP}")
    if(NOT objdump)
        find_program(TTT2_OBJDUMP NAMES objdump llvm-objdump REQUIRED)
        set(objdump "${TTT2_OBJDUMP}")
    endif()
    execute_process(COMMAND "${objdump}" -T ${libraries} OUTPUT_VARIABLE dump RESULT_VARIABLE failed ERROR_QUIET)
    if(failed)
        message(FATAL_ERROR "glibc floor: ${objdump} cannot read ${libraries}")
    endif()
    # Lines such as "...  DF .text  ...  GLIBC_2.43  atan2f" (the default version) and
    # "...  DF .text  ... (GLIBC_2.2.5) atan2f" (an older, hidden one).
    string(REPLACE ";" "" dump "${dump}")
    string(REPLACE "\n" ";" lines "${dump}")
    set(names)
    foreach(line IN LISTS lines)
        if(line MATCHES "\\*UND\\*|\\*ABS\\*" OR NOT line MATCHES " (\\(?)GLIBC_([0-9.]+)\\)? +([A-Za-z_][A-Za-z0-9_]*)$")
            continue()
        endif()
        set(hidden "${CMAKE_MATCH_1}")
        set(version "${CMAKE_MATCH_2}")
        set(name "${CMAKE_MATCH_3}")
        list(APPEND names ${name})
        if(NOT hidden)
            set(default_${name} ${version})
        endif()
        if(version VERSION_LESS_EQUAL floor AND (NOT DEFINED older_${name} OR version VERSION_GREATER older_${name}))
            set(older_${name} ${version})
        endif()
    endforeach()
    list(REMOVE_DUPLICATES names)
    list(SORT names)
    set(pins "")
    set(count 0)
    foreach(name IN LISTS names)
        if(DEFINED default_${name} AND default_${name} VERSION_GREATER floor AND DEFINED older_${name})
            string(APPEND pins "__asm__(\".symver ${name},${name}@GLIBC_${older_${name}}\");\n")
            math(EXPR count "${count} + 1")
        endif()
    endforeach()
    string(REPLACE ";" " " sources "${libraries}")
    file(CONFIGURE OUTPUT "${output}" @ONLY CONTENT
"/* Generated by cmake/GlibcFloor.cmake from @sources@: do not edit.
   Binds the functions this glibc gave a default version newer than GLIBC_@floor@ to their newest version up to it,
   so that the programs compiled with this header start on glibc @floor@. */
#if defined(__linux__) && !defined(__ASSEMBLER__)
@pins@#endif
")
    set(TTT2_GLIBC_FLOOR_PINS ${count} PARENT_SCOPE)
endfunction()

# ttt2_launcher_glibc_floor: an INTERFACE target that force-includes the header into whatever links it (Linux with
# glibc; elsewhere it is empty). TTT2_GLIBC_FLOOR_HEADER names the header (empty where there is none).
if(NOT TARGET ttt2_launcher_glibc_floor)
    add_library(ttt2_launcher_glibc_floor INTERFACE)
    set(TTT2_GLIBC_FLOOR_HEADER "" CACHE INTERNAL "The header ttt2_launcher_glibc_floor force-includes" FORCE)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        execute_process(COMMAND ${CMAKE_C_COMPILER} ${CMAKE_C_COMPILER_ARG1} -print-file-name=libc.so.6
            OUTPUT_VARIABLE libc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(IS_ABSOLUTE "${libc}" AND EXISTS "${libc}")
            set(TTT2_GLIBC_FLOOR_HEADER "${CMAKE_BINARY_DIR}/glibc-floor/ttt2_glibc_floor.h" CACHE INTERNAL
                "The header ttt2_launcher_glibc_floor force-includes" FORCE)
            ttt2_glibc_floor_header("${TTT2_GLIBC_FLOOR_HEADER}" "${TTT2_GLIBC_FLOOR}")
            message(STATUS "glibc floor ${TTT2_GLIBC_FLOOR}: ${TTT2_GLIBC_FLOOR_PINS} functions bound to older versions")
            target_compile_options(ttt2_launcher_glibc_floor INTERFACE
                "$<$<COMPILE_LANGUAGE:C,CXX>:SHELL:-include \"${TTT2_GLIBC_FLOOR_HEADER}\">")
        else()
            message(STATUS "glibc floor: no glibc found (another C library): nothing bound")
        endif()
    endif()
endif()
