# Files built into a program as byte arrays (the launcher's fonts and icons): nothing to install beside it, the same
# on Linux and Windows, and no compiler's #embed needed.
#
#   ttt2_embed_files(<target> NAMESPACE <ns> BASE_DIR <dir> FILES <file>...)
#
# makes the static library <target> and a header <target>.h (on its include path) declaring
#
#   namespace <ns> {
#   struct File { const char* path; const unsigned char* data; std::size_t size; };
#   extern const File* const kFiles[];  // in the order given
#   extern const std::size_t kCount;
#   const File* find(std::string_view path);  // nullptr when there is none
#   }
#
# where path is the file's path relative to BASE_DIR, with '/' (e.g. "Barlow/Barlow-Regular.ttf"). Each file's data
# is followed by one zero byte (not counted in size), and is 16-byte aligned. A file's array is written again when
# the file changes (at build time); adding or removing a file needs CMake to run again.
#
# Run as a script (cmake -DINPUT=... -DOUTPUT=... -DNAMESPACE=... -DINDEX=... -DPATH=... -P EmbedFiles.cmake) it
# writes one file's source: what the build does for each file.
if(CMAKE_SCRIPT_MODE_FILE)
    file(READ "${INPUT}" hex HEX)
    string(LENGTH "${hex}" digits)
    math(EXPR size "${digits} / 2")
    # String literals, 32 bytes each: compilers read them far faster than lists of numbers.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "\\\\x\\1" hex "${hex}")
    string(LENGTH "${hex}" length)
    set(escaped "")
    set(offset 0)
    while(offset LESS length)
        string(SUBSTRING "${hex}" ${offset} 128 line)
        string(APPEND escaped "\n    \"${line}\"")
        math(EXPR offset "${offset} + 128")
    endwhile()
    if(NOT escaped)
        set(escaped "\n    \"\"")
    endif()
    file(WRITE "${OUTPUT}.part"
"// Generated by cmake/EmbedFiles.cmake from ${PATH}: do not edit.
#include \"${HEADER}\"
namespace ${NAMESPACE} {
namespace {
alignas(16) const unsigned char data_${INDEX}[${size} + 1] =${escaped};
}
extern const File file_${INDEX};
const File file_${INDEX} = {\"${PATH}\", data_${INDEX}, ${size}};
}
")
    file(RENAME "${OUTPUT}.part" "${OUTPUT}")
    return()
endif()

include_guard(GLOBAL)
set(TTT2_EMBED_FILES_SCRIPT "${CMAKE_CURRENT_LIST_FILE}")

function(ttt2_embed_files target)
    cmake_parse_arguments(PARSE_ARGV 1 embed "" "NAMESPACE;BASE_DIR" "FILES")
    if(NOT embed_NAMESPACE OR NOT embed_BASE_DIR OR NOT embed_FILES)
        message(FATAL_ERROR "ttt2_embed_files(${target}): NAMESPACE, BASE_DIR and FILES are needed")
    endif()
    set(out "${CMAKE_CURRENT_BINARY_DIR}/${target}")
    set(header "${out}/${target}.h")
    set(sources)
    set(declarations "")
    set(entries "")
    set(index 0)
    foreach(file IN LISTS embed_FILES)
        get_filename_component(file "${file}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        file(RELATIVE_PATH path "${embed_BASE_DIR}" "${file}")
        if(path MATCHES "^\\.\\./|\"|\\\\")
            message(FATAL_ERROR "ttt2_embed_files(${target}): ${file} is not under ${embed_BASE_DIR}")
        endif()
        set(source "${out}/file_${index}.cpp")
        add_custom_command(OUTPUT "${source}"
            COMMAND ${CMAKE_COMMAND} "-DINPUT=${file}" "-DOUTPUT=${source}" "-DNAMESPACE=${embed_NAMESPACE}"
                    "-DINDEX=${index}" "-DPATH=${path}" "-DHEADER=${target}.h" -P "${TTT2_EMBED_FILES_SCRIPT}"
            DEPENDS "${file}" "${TTT2_EMBED_FILES_SCRIPT}"
            COMMENT "Building ${path} into ${target}"
            VERBATIM)
        list(APPEND sources "${source}")
        string(APPEND declarations "extern const File file_${index};\n")
        string(APPEND entries "    &file_${index},\n")
        math(EXPR index "${index} + 1")
    endforeach()
    file(CONFIGURE OUTPUT "${header}" @ONLY CONTENT
"// Generated by cmake/EmbedFiles.cmake (ttt2_embed_files(@target@)): do not edit.
#pragma once
#include <cstddef>
#include <string_view>

namespace @embed_NAMESPACE@ {
struct File {
    const char* path;           // relative to its folder in the source tree, with '/'
    const unsigned char* data;  // size bytes, then a zero byte; 16-byte aligned
    std::size_t size;
};
extern const File* const kFiles[];
extern const std::size_t kCount;
// The file at path, or nullptr.
const File* find(std::string_view path);
}
")
    file(CONFIGURE OUTPUT "${out}/index.cpp" @ONLY CONTENT
"// Generated by cmake/EmbedFiles.cmake (ttt2_embed_files(@target@)): do not edit.
#include \"@target@.h\"

namespace @embed_NAMESPACE@ {
@declarations@
const File* const kFiles[] = {
@entries@};
const std::size_t kCount = sizeof kFiles / sizeof kFiles[0];

const File* find(std::string_view path) {
    for (std::size_t i = 0; i < kCount; ++i)
        if (path == kFiles[i]->path) return kFiles[i];
    return nullptr;
}
}
")
    add_library(${target} STATIC "${out}/index.cpp" ${sources})
    target_include_directories(${target} PUBLIC "${out}")
    target_compile_features(${target} PUBLIC cxx_std_17)
    # (Its strings are longer than the 65536 bytes the C++ standard asks compilers to support; GCC and Clang read any.)
    target_compile_options(${target} PRIVATE $<$<CXX_COMPILER_ID:GNU,Clang>:-Wno-overlength-strings>)
endfunction()
