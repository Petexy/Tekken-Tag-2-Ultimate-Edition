FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "@rc_DESCRIPTION@"
      VALUE "FileVersion", "@TTT2_LAUNCHER_VERSION@"
      VALUE "InternalName", "@rc_NAME@"
      VALUE "OriginalFilename", "@rc_FILENAME@"
      VALUE "ProductName", "Tekken Tag 2 Ultimate Edition"
      VALUE "ProductVersion", "@TTT2_LAUNCHER_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
