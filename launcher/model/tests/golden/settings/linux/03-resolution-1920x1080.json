  "settings": [
    {"k": "label", "t": "Game", "tone": "heading"},
    {"k": "label", "t": "The game uses these when it starts.", "tone": "dim"},
    {"k": "label", "t": "Fullscreen"},
    {"k": "label", "t": "Start the game fullscreen. F11 switches it in the game.", "tone": "dim"},
    {"k": "switch", "id": "fullscreen", "on": true, "s": true},
    {"k": "label", "t": "Resolution"},
    {"k": "label", "t": "The size the game draws at; the picture is scaled to the window or the screen.", "tone": "dim"},
    {"k": "label", "t": "Automatic: enough to cover the display (1280 × 720 on this one).", "tone": "dim"},
    {"k": "choice", "id": "resolution", "t": "1920 × 1080", "s": true},
    {"k": "label", "t": "120 fps"},
    {"k": "label", "t": "A frame between each two of the game's 60 every second: smoother motion on displays of 100 Hz and more.", "tone": "dim"},
    {"k": "switch", "id": "interpolation", "on": true, "s": true},
    {"k": "label", "t": "Input delay"},
    {"k": "label", "t": "Two frames between a button press and the game acting on it, as on the Wii U. Practice's own Input Delay works either way.", "tone": "dim"},
    {"k": "switch", "id": "input-delay", "on": false, "s": true},
    {"k": "label", "t": "Shaders in the background"},
    {"k": "label", "t": "The first time something is shown, it may appear a few frames late instead of the game stopping for a moment while its shader is made.", "tone": "dim"},
    {"k": "switch", "id": "async-shaders", "on": false, "s": true},
    {"k": "label", "t": "Prepare shaders before playing"},
    {"k": "label", "t": "Play first makes ready the shaders the game has used on this PC so far, so that it does not stop for them again, for instance after a graphics driver update. What it has never shown yet is still made the first time.", "tone": "dim"},
    {"k": "switch", "id": "precompile-shaders", "on": false, "s": true},
    {"k": "label", "t": "Keyboard", "tone": "heading"},
